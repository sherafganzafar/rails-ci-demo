// BASELINE: everything runs one stage after another, no cache, no parallelism.
pipeline {
  agent { docker { image 'ruby:3.3' } }
  options { timestamps() }

  stages {
    stage('Install gems') {
      steps { retry(5) { sh 'bundle install --quiet --retry 5' } }
    }
    stage('Lint') {
      steps { sh 'bundle exec rubocop' }
    }
    stage('Security') {
      steps {
        sh 'bundle exec brakeman -q --no-pager'
        sh 'gem install bundler-audit && bundle-audit check --update'
      }
    }
    stage('Test') {
      steps { sh 'RAILS_ENV=test bin/rails db:test:prepare test' }
    }
  }
}
